# Порт, на котором запускается магазин
PORT=5050

# Публичный адрес сайта (без слэша на конце). Для заглушки нужен, чтобы «банк» мог отправить webhook магазину.
# Локально оставьте пустым. На хостинге впишите адрес вида https://my-shop.example.com
BASE_URL=

# Какой платёжный модуль подключён. Сейчас доступен только fake (тестовая оплата).
PAYMENT_PROVIDER=fake

# Секрет для подписи webhook. Для заглушки можно оставить пустым — тогда создаётся случайный на время работы.
# Для реального провайдера впишите секрет из его личного кабинета. НИКОГДА не выкладывайте его в публичный репозиторий.
PAYMENT_WEBHOOK_SECRET=

# Необязательно: где хранить базу (по умолчанию shop.db рядом с проектом)
# DB_PATH=shop.db
