# Токен бота: создайте бота у @BotFather в Telegram и скопируйте сюда
BOT_TOKEN=put_your_token_here

# --- Модель ---
# mock   — режим без нейросети: бот цитирует найденный фрагмент базы знаний (бесплатно, для проверки)
# openai — настоящая языковая модель по OpenAI-совместимому API
LLM_PROVIDER=mock

# Нужно только для LLM_PROVIDER=openai. НИКОГДА не выкладывайте этот ключ в публичный репозиторий.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Примеры других провайдеров (актуальные названия моделей смотрите у провайдера):
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  (ключ любой непустой, например ollama)

# --- Компания ---
COMPANY_NAME=Борода (демо)
OPERATOR_CONTACT=@your_telegram
# Для реального клиента поставьте пустую строку, чтобы убрать пометку про демо
DEMO_NOTICE=Это демо-проект из портфолио: компания вымышленная, данные ненастоящие.
KNOWLEDGE_FILE=knowledge/faq.txt

# --- Ограничения ---
DAILY_MESSAGE_LIMIT=20
HISTORY_MESSAGES=10
MAX_QUESTION_CHARS=800
TIMEZONE=Europe/Moscow
