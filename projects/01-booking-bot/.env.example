# Токен бота: создайте бота у @BotFather в Telegram и скопируйте сюда
BOT_TOKEN=put_your_token_here

# Ваш Telegram ID (числом). Узнать: написать боту @userinfobot
# Сюда будут приходить уведомления о новых записях и отменах
OWNER_ID=

# Необязательно: ещё админы (могут вызывать /today), через запятую
ADMIN_IDS=

# Необязательно: где хранить базу (по умолчанию bookings.db рядом с проектом)
# DB_PATH=bookings.db
